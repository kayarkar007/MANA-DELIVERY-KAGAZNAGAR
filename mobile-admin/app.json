{
  "expo": {
    "name": "Mana Delivery Admin",
    "slug": "mana-delivery-admin",
    "scheme": "manadeliveryadmin",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#090405"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.manadelivery.admin"
    },
    "android": {
      "package": "com.manadelivery.admin",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#090405"
      },
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-notifications"
    ],
    "extra": {
      "eas": {
        "projectId": "6572799c-2579-4320-9a06-f6cb5a336398"
      }
    },
    "owner": "kk_events_and_water_plant"
  }
}
