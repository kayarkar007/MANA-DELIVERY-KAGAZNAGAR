{
  "java.import.gradle.enabled": false,
  "java.import.maven.enabled": false,
  "java.import.exclusions": [
    "**/node_modules/**",
    "**/mobile/node_modules/**",
    "**/.metadata/**",
    "**/archetype/**",
    "**/META-INF/maven/**"
  ],
  "java.project.exclusion": [
    "**/node_modules/**",
    "**/mobile/node_modules/**"
  ],
  "java.project.resourceFilters": [
    "node_modules"
  ],
  "java.jdt.ls.lombokSupport.enabled": false,
  "java.autobuild.enabled": false,
  "gradle.autoDetect": "off",
  "gradle.nestedProjects": false,
  "gradle.projectOpenMode": "none",
  "java.configuration.detectJdksAtStart": false,
  "css.lint.unknownAtRules": "ignore",
  "files.watcherExclude": {
    "**/node_modules/**": true,
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/.next/**": true
  },
  "files.exclude": {
    "**/node_modules": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/.next": true
  }
}
