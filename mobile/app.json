{
  "expo": {
    "name": "Mana Delivery",
    "slug": "mana-delivery",
    "scheme": "manadelivery",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.manadelivery.app"
    },
    "android": {
      "package": "com.manadelivery.app",
      "adaptiveIcon": {
        "backgroundColor": "#090405",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "permissions": [
        "CAMERA",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "POST_NOTIFICATIONS",
        "VIBRATE",
        "RECEIVE_BOOT_COMPLETED"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#090405"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "25f712ac-f222-440c-8c36-14c525793537"
      }
    },
    "owner": "kk_events_and_water_plant"
  }
}
